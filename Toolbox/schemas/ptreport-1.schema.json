{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ptreport-1.schema.json",
  "title": "PowerTower report (ptreport/1): one JSON document per deliverable. Every row carries a stable id, severity, status, evidence, frameworkRefs and an asOf stamp.",
  "type": "object",
  "required": ["schema", "report", "title", "subject", "asOf", "summary", "rows", "unconfirmed", "remediation", "method", "brand"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ptreport/1" },
    "report": { "enum": ["vulnerability", "hardening", "compromise"] },
    "title": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["host", "platform", "mode", "os", "runId", "collectedUtc", "enrichedUtc"],
      "properties": {
        "host": { "type": "string" },
        "domain": { "type": "string" },
        "platform": { "enum": ["windows", "linux"] },
        "mode": { "enum": ["live", "image"] },
        "os": { "type": "object", "required": ["productName", "fullBuild"], "properties": { "productName": { "type": "string" }, "displayVersion": { "type": "string" }, "fullBuild": { "type": "string" }, "arch": { "type": "string" } } },
        "runId": { "type": "string" },
        "engagementId": { "type": "string" },
        "collectedUtc": { "type": "string" },
        "enrichedUtc": { "type": "string" },
        "privilegeTier": { "type": "string" },
        "collector": { "type": "object" }
      }
    },
    "asOf": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["open", "patched", "total", "critical", "high", "medium", "low", "knownExploited", "unconfirmed", "status", "assessable", "coverage"],
      "properties": {
        "open": { "type": "integer", "minimum": 0 }, "patched": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 }, "high": { "type": "integer", "minimum": 0 }, "medium": { "type": "integer", "minimum": 0 }, "low": { "type": "integer", "minimum": 0 },
        "knownExploited": { "type": "integer", "minimum": 0 }, "unconfirmed": { "type": "integer", "minimum": 0 },
        "msrcWindow": { "type": "integer", "minimum": 0 }, "releases": { "type": "array", "items": { "type": "string" } }, "headline": { "type": "string" },
      "status": { "enum": ["assessed", "incomplete-coverage", "not-assessable"] }, "assessable": { "type": "boolean" }, "unrated": { "type": "integer", "minimum": 0 },
      "coverage": { "type": "object", "required": ["status", "releasesChecked", "releasesExpected", "feedsUnavailable", "problems", "text"], "properties": {
        "status": { "enum": ["assessed", "incomplete-coverage", "not-assessable"] }, "releasesChecked": { "type": "integer", "minimum": 0 }, "releasesExpected": { "type": "integer", "minimum": 0 },
        "feedsUnavailable": { "type": "array", "items": { "type": "string" } }, "problems": { "type": "integer", "minimum": 0 }, "text": { "type": "string" } } }
      }
    },
    "rows": { "type": "array", "items": { "$ref": "#/definitions/row" } },
    "unconfirmed": { "type": "array", "items": { "$ref": "#/definitions/row" } },
    "remediation": {
      "type": "object",
      "required": ["byUpdate", "byProduct"],
      "properties": {
        "byUpdate": { "type": "array", "items": { "type": "object", "required": ["kb", "cves", "openCount", "worstSeverity"], "properties": { "kb": { "type": "string" }, "cves": { "type": "array", "items": { "type": "string" } }, "products": { "type": "array", "items": { "type": "string" } }, "openCount": { "type": "integer" }, "worstSeverity": { "type": "string" }, "knownExploited": { "type": "boolean" } } } },
        "byProduct": { "type": "array", "items": { "type": "object", "required": ["product", "cves", "openCount", "worstSeverity"], "properties": { "product": { "type": "string" }, "installed": { "type": "string" }, "fix": { "type": "string" }, "cves": { "type": "array", "items": { "type": "string" } }, "openCount": { "type": "integer" }, "worstSeverity": { "type": "string" }, "knownExploited": { "type": "boolean" } } } }
      }
    },
    "method": {
      "type": "object",
      "required": ["text", "limitations", "coverage"],
      "properties": { "text": { "type": "string" }, "limitations": { "type": "array", "items": { "type": "string" } }, "coverage": { "type": "object" } }
    },
    "brand": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "line": { "type": "string" }, "footer": { "type": "string" } } }
  },
  "definitions": {
    "frameworkRef": { "type": "object", "required": ["framework", "ref"], "properties": { "framework": { "type": "string" }, "ref": { "type": "string" }, "note": { "type": "string" } } },
    "row": {
      "type": "object",
      "required": ["id", "severity", "status", "evidence", "frameworkRefs", "asOf", "title", "cve", "source", "product", "validated"],
      "properties": {
        "id": { "type": "string", "pattern": "^PT-[WL]-[A-Z]+-" },
        "severity": { "enum": ["Critical", "High", "Medium", "Low", "Unrated"] },
        "status": { "enum": ["vulnerable", "update available", "reboot pending", "patched", "unconfirmed"] },
        "evidence": { "type": "string" },
        "frameworkRefs": { "type": "array", "items": { "$ref": "#/definitions/frameworkRef" } },
        "asOf": { "type": "string" },
        "title": { "type": "string" },
        "cve": { "type": "string", "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|ADV[0-9]+)$" },
        "source": { "type": "string" },
        "product": { "type": "string" },
        "installed": { "type": "string" },
        "fix": { "type": "string" },
        "cvss": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "epss": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "kev": { "type": "boolean" },
        "ransomware": { "type": "boolean" },
        "kevDue": { "type": "string" },
        "exploited": { "type": "boolean" },
        "url": { "type": "string" },
        "release": { "type": "string" },
        "validated": { "enum": ["confirmed", "not exploitable", "untested"] },
        "open": { "type": "boolean" },
        "rank": { "type": "integer", "minimum": 1 },
        "score": { "type": "number" }
      }
    }
  }
}
